#######################################################
# SPECIAL FUNCTIONS
#######################################################
# Extracts any archive(s) (if unp isn't installed)
extract() {
	for archive in "$@"; do
		if [ -f "$archive" ]; then
			case $archive in
			*.tar.bz2) tar xvjf $archive ;;
			*.tar.gz) tar xvzf $archive ;;
			*.bz2) bunzip2 $archive ;;
			*.rar) rar x $archive ;;
			*.gz) gunzip $archive ;;
			*.tar) tar xvf $archive ;;
			*.tbz2) tar xvjf $archive ;;
			*.tgz) tar xvzf $archive ;;
			*.zip) unzip $archive ;;
			*.Z) uncompress $archive ;;
			*.7z) 7z x $archive ;;
			*) echo "don't know how to extract '$archive'..." ;;
			esac
		else
			echo "'$archive' is not a valid file!"
		fi
	done
}

# Searches for text in all files in the current folder
ftext() {
	# -i case-insensitive
	# -I ignore binary files
	# -H causes filename to be printed
	# -r recursive search
	# -n causes line number to be printed
	# optional: -F treat search term as a literal, not a regular expression
	# optional: -l only print filenames and not the matching lines ex. grep -irl "$1" *
	grep -iIHrn --color=always "$1" . | less -r
}

# Copy file with a progress bar
cpp() {
    set -e
    strace -q -ewrite cp -- "${1}" "${2}" 2>&1 |
    awk '{
        count += $NF
        if (count % 10 == 0) {
            percent = count / total_size * 100
            printf "%3d%% [", percent
            for (i=0;i<=percent;i++)
                printf "="
            printf ">"
            for (i=percent;i<100;i++)
                printf " "
            printf "]\r"
        }
    }
    END { print "" }' total_size="$(stat -c '%s' "${1}")" count=0
}

# Copy and go to the directory
cpg() {
	if [ -d "$2" ]; then
		cp "$1" "$2" && cd "$2"
	else
		cp "$1" "$2"
	fi
}

# Move and go to the directory
mvg() {
	if [ -d "$2" ]; then
		mv "$1" "$2" && cd "$2"
	else
		mv "$1" "$2"
	fi
}

# Create and go to the directory
mkdirg() {
	mkdir -p "$1"
	cd "$1"
}

# Goes up a specified number of directories  (i.e. up 4)
up() {
	local d=""
	limit=$1
	for ((i = 1; i <= limit; i++)); do
		d=$d/..
	done
	d=$(echo $d | sed 's/^\///')
	if [ -z "$d" ]; then
		d=..
	fi
	cd $d
}

# Automatically do an ls after each cd, z, or zoxide
cd ()
{
	if [ -n "$1" ]; then
		builtin cd "$@" && ls
	else
		builtin cd ~ && ls
	fi
}

# Returns the last 2 fields of the working directory
pwdtail() {
	pwd | awk -F/ '{nlast = NF -1;print $nlast"/"$NF}'
}

# Show the current distribution
distribution () {
    local dtype="unknown"  # Default to unknown

    # Use /etc/os-release for modern distro identification
    if [ -r /etc/os-release ]; then
        source /etc/os-release
        case $ID in
            fedora|rhel|centos)
                dtype="redhat"
                ;;
            sles|opensuse*)
                dtype="suse"
                ;;
            ubuntu|debian)
                dtype="debian"
                ;;
            gentoo)
                dtype="gentoo"
                ;;
            arch|manjaro)
                dtype="arch"
                ;;
            slackware)
                dtype="slackware"
                ;;
            *)
                # Check ID_LIKE only if dtype is still unknown
                if [ -n "$ID_LIKE" ]; then
                    case $ID_LIKE in
                        *fedora*|*rhel*|*centos*)
                            dtype="redhat"
                            ;;
                        *sles*|*opensuse*)
                            dtype="suse"
                            ;;
                        *ubuntu*|*debian*)
                            dtype="debian"
                            ;;
                        *gentoo*)
                            dtype="gentoo"
                            ;;
                        *arch*)
                            dtype="arch"
                            ;;
                        *slackware*)
                            dtype="slackware"
                            ;;
                    esac
                fi

                # If ID or ID_LIKE is not recognized, keep dtype as unknown
                ;;
        esac
    fi

    echo $dtype
}

# Show the current version of the operating system
ver() {
    local dtype
    dtype=$(distribution)

    case $dtype in
        "redhat")
            if [ -s /etc/redhat-release ]; then
                cat /etc/redhat-release
            else
                cat /etc/issue
            fi
            uname -a
            ;;
        "suse")
            cat /etc/SuSE-release
            ;;
        "debian")
            lsb_release -a
            ;;
        "gentoo")
            cat /etc/gentoo-release
            ;;
        "arch")
            cat /etc/os-release
            ;;
        "slackware")
            cat /etc/slackware-version
            ;;
        *)
            if [ -s /etc/issue ]; then
                cat /etc/issue
            else
                echo "Error: Unknown distribution"
                exit 1
            fi
            ;;
    esac
}

# Automatically install the needed support files for this .bashrc file
install_bashrc_support() {
	local dtype
	dtype=$(distribution)

	case $dtype in
		"redhat")
			sudo yum install multitail tree zoxide trash-cli fzf bash-completion fastfetch
			;;
		"suse")
			sudo zypper install multitail tree zoxide trash-cli fzf bash-completion fastfetch
			;;
		"debian")
			sudo apt-get install multitail tree zoxide trash-cli fzf bash-completion
			# Fetch the latest fastfetch release URL for linux-amd64 deb file
			FASTFETCH_URL=$(curl -s https://api.github.com/repos/fastfetch-cli/fastfetch/releases/latest | grep "browser_download_url.*linux-amd64.deb" | cut -d '"' -f 4)

			# Download the latest fastfetch deb file
			curl -sL $FASTFETCH_URL -o /tmp/fastfetch_latest_amd64.deb

			# Install the downloaded deb file using apt-get
			sudo apt-get install /tmp/fastfetch_latest_amd64.deb
			;;
		"arch")
			sudo paru multitail tree zoxide trash-cli fzf bash-completion fastfetch
			;;
		"slackware")
			echo "No install support for Slackware"
			;;
		*)
			echo "Unknown distribution"
			;;
	esac
}

# IP address lookup
alias whatismyip="whatsmyip"
function whatsmyip () {
    # Internal IP Lookup.
    if command -v ip &> /dev/null; then
        echo -n "Internal IP: "
        ip addr show wlan0 | grep "inet " | awk '{print $2}' | cut -d/ -f1
    else
        echo -n "Internal IP: "
        ifconfig wlan0 | grep "inet " | awk '{print $2}'
    fi

    # External IP Lookup
    echo -n "External IP: "
    curl -s ifconfig.me
}


# Trim leading and trailing spaces (for scripts)
trim() {
	local var=$*
	var="${var#"${var%%[![:space:]]*}"}" # remove leading whitespace characters
	var="${var%"${var##*[![:space:]]}"}" # remove trailing whitespace characters
	echo -n "$var"
}
# GitHub Titus Additions

gcom() {
	git add .
	git commit -m "$1"
}
lazyg() {
	git add .
	git commit -m "$1"
	git push
}

# Function to download a GitHub file to the current directory
download_github_file() {
    local url="$1"
    local filename="$2"
    
    # Check if URL is provided
    if [ -z "$url" ]; then
        echo "Error: No URL provided"
        echo "Usage: download_github_file <github_url> [filename]"
        return 1
    fi
    
    # Convert GitHub URL to raw URL if needed
    if [[ "$url" = *"github.com"* ]] && [[ "$url" != *"raw.githubusercontent.com"* ]]; then
        # Convert from github.com/user/repo/blob/branch/path to raw.githubusercontent.com/user/repo/branch/path
        raw_url=$(echo "$url" | sed 's|github\.com|raw.githubusercontent.com|' | sed 's|/blob/|/|')
    else
        raw_url="$url"
    fi
    
    # Extract filename from URL if not provided
    if [ -z "$filename" ]; then
        filename=$(basename "$raw_url")
    fi
    
    # Check if filename could be extracted
    if [ -z "$filename" ] || [ "$filename" = "/" ]; then
        echo "Error: Could not determine filename. Please provide a filename as second argument."
        return 1
    fi
    
    echo "Downloading: $raw_url"
    echo "Saving as: $filename"
    
    # Download the file using curl
    if command -v curl >/dev/null 2>&1; then
        if curl -L -o "$filename" "$raw_url"; then
            echo "Successfully downloaded: $filename"
            return 0
        else
            echo "Error: Failed to download file"
            return 1
        fi
    # Fallback to wget if curl is not available
    elif command -v wget >/dev/null 2>&1; then
        if wget -O "$filename" "$raw_url"; then
            echo "Successfully downloaded: $filename"
            return 0
        else
            echo "Error: Failed to download file"
            return 1
        fi
    else
        echo "Error: Neither curl nor wget is available"
        return 1
    fi
}
# Alternative shorter function name
alias ghget='download_github_file'



kubie-auth() {
    local configs_dir="${HOME}/.kube/configs"
    local selected_config context_name kubeconfig_path

    # Check if fzf is installed
    if ! command -v fzf >/dev/null 2>&1; then
        echo >&2 "Error: fzf is not installed. Please install it first."
        echo >&2 "  Ubuntu/Debian: sudo apt install fzf"
        echo >&2 "  macOS: brew install fzf"
        echo >&2 "  Or visit: https://github.com/junegunn/fzf#installation"
        return 1
    fi

    # Check if configs directory exists
    if [ ! -d "$configs_dir" ]; then
        echo >&2 "Error: Directory $configs_dir does not exist"
        return 1
    fi

    # Select kubeconfig file
    echo "Select a kubeconfig file:"
    selected_config=$(find "$configs_dir" -type f -printf "%P\n" 2>/dev/null | sort | fzf --prompt="Select kubeconfig: " --height=40% --border)
    [ -z "$selected_config" ] && { echo >&2 "No config file selected. Exiting."; return 1; }

    kubeconfig_path="${configs_dir}/${selected_config}"
    echo "Selected kubeconfig: $kubeconfig_path"

    # Get available contexts
    export KUBECONFIG="$kubeconfig_path"
    local contexts=($(kubectl config get-contexts -o name 2>/dev/null))
    [ ${#contexts[@]} -eq 0 ] && { echo >&2 "Error: No contexts found in the selected kubeconfig file"; return 1; }

    # Select context
    if [ ${#contexts[@]} -eq 1 ]; then
        context_name="${contexts[1]}"
        echo "Using single available context: $context_name"
    else
        echo "Select a context:"
        context_name=$(printf '%s\n' "${contexts[@]}" | fzf --prompt="Select context: " --height=40% --border)
        [ -z "$context_name" ] && { echo >&2 "No context selected. Exiting."; return 1; }
    fi

    echo "Selected context: $context_name"
    echo "Authenticating to Kubernetes cluster..."

    # Switch context and authenticate
    kubectl config use-context "$context_name" >/dev/null
    echo "Triggering authentication flow..."
    echo "If a browser opens, complete the authentication there..."
    
    if kubectl get pods --request-timeout=300s >/dev/null 2>&1; then
        echo "Authentication successful!"
        echo "Starting kubie with context: $context_name"
        kubie ctx "$context_name"
    else
        echo >&2 "Authentication failed or timed out"
        echo >&2 "Please check your network connection and try again"
        return 1
    fi
}
# Optional: Create shorter aliases
alias ka='kubie-auth'
alias kauth='kubie-auth'


# function to logout of pinniped

pinniped-logout() {
 rm -rf $HOME/.config/pinniped/sessions.yaml*
 echo "Pinniped session cleared. You are now logged out."
 rm -rf $HOME/.config/pinniped/credentials.yaml*
 echo "Pinniped credentials cleared. You are now logged out."
}

alias plogout='pinniped-logout'