#!/usr/bin/env bash
# repo-sync: register/unregister repos as Syncthing shared folders via REST API
set -euo pipefail

SYNCTHING_API="${STSYNC_URL:-http://127.0.0.1:8384}"
GHQ_ROOT="${GHQ_ROOT:-$HOME/repos}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
STIGNORE_TEMPLATE="${STIGNORE_TEMPLATE:-$SCRIPT_DIR/../syncthing/stignore.template}"
STSYNC_SERVER_URL="${STSYNC_SERVER_URL:-https://sync.ayplace.xyz}"
STSYNC_SERVER_REPOS_ROOT="${STSYNC_SERVER_REPOS_ROOT:-/var/syncthing/data}"

# ---------------------------------------------------------------------------
# Config helpers
# ---------------------------------------------------------------------------

_get_api_key() {
    if [[ -n "${STSYNC_APIKEY:-}" ]]; then
        printf '%s' "$STSYNC_APIKEY"
        return
    fi
    local cfg="$HOME/.local/state/syncthing/config.xml"
    if [[ ! -f "$cfg" ]]; then
        printf 'Error: Syncthing config not found at %s\n' "$cfg" >&2
        printf '  Set STSYNC_APIKEY=<key> or run Syncthing once so it creates %s\n' "$cfg" >&2
        return 1
    fi
    local key
    key=$(sed -n 's|.*<apikey>\([^<]*\)</apikey>.*|\1|p' "$cfg")
    if [[ -z "$key" ]]; then
        printf 'Error: Could not parse <apikey> from %s\n' "$cfg" >&2
        return 1
    fi
    printf '%s' "$key"
}

_get_server_device_id() {
    if [[ -n "${STSYNC_SERVER_DEVICE_ID:-}" ]]; then
        printf '%s' "$STSYNC_SERVER_DEVICE_ID"
        return
    fi
    # Fall back to the persisted value in ~/.shell/.env (not sourced in
    # non-interactive shells), mirroring syncthing/setup-syncthing.sh.
    local env_file="$HOME/.shell/.env" id
    if [[ -f "$env_file" ]]; then
        id=$(sed -n 's|^export STSYNC_SERVER_DEVICE_ID="\{0,1\}\([^"]*\)"\{0,1\}.*|\1|p' "$env_file" | head -n1)
        if [[ -n "$id" ]]; then
            printf '%s' "$id"
            return
        fi
    fi
    # shellcheck disable=SC2016
    printf 'Error: $STSYNC_SERVER_DEVICE_ID is not set.\n' >&2
    printf '  Set it to the Syncthing device ID of your hub server.\n' >&2
    printf '  Find it in the Syncthing web UI: Actions > Show ID.\n' >&2
    return 1
}

_rel_from_path() { local rel="${1#"$GHQ_ROOT/"}"; printf '%s' "${rel#/}"; }
_folder_id_from_rel() { printf '%s' "${1//\//-}"; }
_path_from_rel() { printf '%s' "$GHQ_ROOT/$1"; }
_url_from_rel() { local rel="$1"; printf 'git@%s:%s.git' "${rel%%/*}" "${rel#*/}"; }
_rel_from_url() {
    local url="${1%.git}"
    case "$url" in
        ssh://*) url="${url#ssh://}"; url="${url#*@}"; url="${url/:/\/}" ;;
        git@*)   url="${url#git@}"; url="${url/:/\/}" ;;
        *://*)   url="${url#*://}"; url="${url#*@}" ;;
    esac
    printf '%s' "$url"
}

# Legacy compat wrapper (used internally)
_path_to_folder_id() { _folder_id_from_rel "$(_rel_from_path "$1")"; }

# ---------------------------------------------------------------------------
# Hub REST helpers
# ---------------------------------------------------------------------------

_require_hub_key() {
    if [[ -z "${STSYNC_SERVER_APIKEY:-}" ]]; then
        printf 'Error: STSYNC_SERVER_APIKEY is not set (needed for hub operations).\n' >&2
        printf '  Put it in ~/.shell/.env.local (never the git-tracked ~/.shell/.env).\n' >&2
        return 1
    fi
}
_hub_curl() { # METHOD PATH [JSON]
    local method="$1" path="$2" data="${3:-}"
    local args=(-s --max-time 15 -H "X-API-Key: $STSYNC_SERVER_APIKEY" -X "$method")
    [[ -n "$data" ]] && args+=(-H "Content-Type: application/json" -d "$data")
    curl "${args[@]}" "$STSYNC_SERVER_URL$path"
}
_hub_code() { # METHOD PATH  -> http status only
    curl -s -o /dev/null -w '%{http_code}' --max-time 15 \
        -H "X-API-Key: $STSYNC_SERVER_APIKEY" -X "$1" "$STSYNC_SERVER_URL$2"
}
_hub_laptop_devices() { # -> JSON array of device IDs excluding the hub
    local hub_id; hub_id="$(_get_server_device_id)" || return 1
    _hub_curl GET /rest/config/devices \
      | python3 -c "import sys,json;hub='$hub_id';print(json.dumps([d['deviceID'] for d in json.load(sys.stdin) if d['deviceID']!=hub]))"
}
_hub_upsert_folder() { # folder_id rel
    _require_hub_key || return 1
    local fid="$1" rel="$2" devices payload code
    devices="$(_hub_laptop_devices)" || return 1
    payload=$(python3 -c "
import json
devs=json.loads('''$devices''')
print(json.dumps({
 'id':'$fid','label':'$rel','path':'$STSYNC_SERVER_REPOS_ROOT/$rel','type':'sendreceive',
 'devices':[{'deviceID':d} for d in devs],'fsWatcherEnabled':True,'rescanIntervalS':3600,
 'versioning':{'type':'staggered','params':{'cleanInterval':'3600','maxAge':'2592000'}}}))")
    if [[ "$(_hub_code GET "/rest/config/folders/$fid")" == "200" ]]; then
        code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 -H "X-API-Key: $STSYNC_SERVER_APIKEY" \
               -H "Content-Type: application/json" -X PATCH -d "$payload" "$STSYNC_SERVER_URL/rest/config/folders/$fid")
    else
        code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 -H "X-API-Key: $STSYNC_SERVER_APIKEY" \
               -H "Content-Type: application/json" -X POST -d "$payload" "$STSYNC_SERVER_URL/rest/config/folders")
    fi
    [[ "$code" == "200" ]] || { printf 'Error: hub folder upsert returned HTTP %s\n' "$code" >&2; return 1; }
}

# ---------------------------------------------------------------------------
# Subcommands
# ---------------------------------------------------------------------------

cmd_add() {
    local repo_path="${1:-}"
    if [[ -z "$repo_path" ]]; then
        printf 'Usage: repo-sync add <repo-path>\n' >&2
        return 1
    fi

    local abs_path
    abs_path="$(realpath -m "$repo_path")"
    if [[ ! -d "$abs_path" ]]; then
        printf 'Error: Directory not found: %s\n' "$abs_path" >&2
        return 1
    fi

    local api_key server_device_id folder_id
    api_key="$(_get_api_key)"
    server_device_id="$(_get_server_device_id)"
    folder_id="$(_folder_id_from_rel "$(_rel_from_path "$abs_path")")"

    printf 'Registering "%s" as Syncthing folder "%s"...\n' "$abs_path" "$folder_id"

    # Apply .stignore template so build artefacts are excluded from day one
    local template
    template="$(realpath -m "$STIGNORE_TEMPLATE")"
    if [[ -f "$template" ]]; then
        cp "$template" "$abs_path/.stignore"
        printf '  Applied .stignore from %s\n' "$template"
    else
        printf '  Warning: stignore template not found at %s — skipping\n' "$template" >&2
    fi

    # POST the folder config to the local Syncthing instance
    local payload http_code
    payload='{"id":"'"$folder_id"'","label":"'"$(_rel_from_path "$abs_path")"'","path":"'"$abs_path"'","type":"sendreceive","devices":[{"deviceID":"'"$server_device_id"'","introducedBy":""}],"rescanIntervalS":3600,"fsWatcherEnabled":true,"fsWatcherDelayS":10,"ignorePerms":false,"autoNormalize":true}'

    http_code=$(curl -s -o /dev/null -w '%{http_code}' \
        -X POST \
        -H "X-API-Key: $api_key" \
        -H "Content-Type: application/json" \
        -d "$payload" \
        "$SYNCTHING_API/rest/config/folders")

    if [[ "$http_code" == "200" ]]; then
        printf '  Done. Syncthing will begin syncing "%s" with the server.\n' "$folder_id"
        printf '  Accept the folder on other devices or wait for Introducer propagation.\n'
    else
        printf 'Error: Syncthing API returned HTTP %s\n' "$http_code" >&2
        printf '  Is Syncthing running? Is the API key correct?\n' >&2
        return 1
    fi

    # Mirror the folder onto the hub so every laptop can adopt it.
    if [[ -n "${STSYNC_SERVER_APIKEY:-}" ]]; then
        local rel; rel="$(_rel_from_path "$abs_path")"
        if _hub_upsert_folder "$folder_id" "$rel"; then
            printf '  Hub: folder shared with all laptops (versioning on).\n'
        else
            printf '  Warning: could not configure hub (folder still works locally).\n' >&2
        fi
    else
        printf '  Note: STSYNC_SERVER_APIKEY unset — skipped hub sharing.\n'
    fi
}

cmd_list() {
    local api_key
    api_key="$(_get_api_key)"

    local response
    response=$(curl -s \
        -H "X-API-Key: $api_key" \
        "$SYNCTHING_API/rest/config/folders")

    if command -v jq >/dev/null 2>&1; then
        printf '%s\n' "$response" \
            | jq -r '.[] | "\(.id)\t\(.path)"' 2>/dev/null \
            || printf '(no folders configured or unexpected response)\n'
    else
        # Fallback: extract IDs with sed
        printf '%s\n' "$response" \
            | sed -n 's/.*"id":"\([^"]*\)".*/\1/p' \
            || printf '(no folders configured)\n'
    fi
}

cmd_rm() {
    local repo_path="${1:-}"
    if [[ -z "$repo_path" ]]; then
        printf 'Usage: repo-sync rm <repo-path>\n' >&2
        return 1
    fi

    local abs_path folder_id api_key rel
    abs_path="$(realpath -m "$repo_path")"
    rel="$(_rel_from_path "$abs_path")"
    folder_id="$(_folder_id_from_rel "$rel")"
    api_key="$(_get_api_key)"

    printf 'Removing Syncthing folder "%s"...\n' "$folder_id"

    local http_code
    http_code=$(curl -s -o /dev/null -w '%{http_code}' \
        -X DELETE \
        -H "X-API-Key: $api_key" \
        "$SYNCTHING_API/rest/config/folders/$folder_id")

    if [[ "$http_code" == "200" ]]; then
        printf '  Local: folder "%s" removed. Local files are unchanged.\n' "$folder_id"
    else
        printf 'Error: Local Syncthing API returned HTTP %s\n' "$http_code" >&2
        printf '  The folder may not exist or the API key may be wrong.\n' >&2
        return 1
    fi

    if [[ -n "${STSYNC_SERVER_APIKEY:-}" ]]; then
        http_code=$(_hub_code DELETE "/rest/config/folders/$folder_id")
        if [[ "$http_code" == "200" ]]; then
            printf '  Hub: folder "%s" removed — other laptops will stop syncing it.\n' "$folder_id"
        else
            printf '  Warning: hub returned HTTP %s — remove manually if needed.\n' "$http_code" >&2
        fi
    else
        printf '  Note: STSYNC_SERVER_APIKEY unset — folder removed locally only.\n'
    fi
}

cmd_get() {
    local url="${1:-}"
    [[ -n "$url" ]] || { printf 'Usage: repo-sync get <git-url>\n' >&2; return 1; }
    local rel; rel="$(_rel_from_url "$url")"
    printf 'Cloning %s via ghq...\n' "$url"
    ghq get "$url" || { printf 'Error: ghq get failed for %s\n' "$url" >&2; return 1; }
    cmd_add "$(_path_from_rel "$rel")"
}

cmd_adopt() {
    _require_hub_key || return 1
    local folders rel local_path
    folders="$(_hub_curl GET /rest/config/folders \
        | python3 -c "import sys,json;[print(f['label']) for f in json.load(sys.stdin) if f.get('label')]")"
    [[ -n "$folders" ]] || { printf 'No labelled repo folders on the hub yet.\n'; return 0; }
    while IFS= read -r rel; do
        [[ -n "$rel" ]] || continue
        local_path="$(_path_from_rel "$rel")"
        if [[ -d "$local_path" ]]; then
            printf 'Have %s — ensuring it is registered...\n' "$rel"
        else
            printf 'Adopting %s — Syncthing will pull it from the hub...\n' "$rel"
            mkdir -p "$local_path"
        fi
        cmd_add "$local_path"
    done <<< "$folders"
}

cmd_status() {
    local api_key; api_key="$(_get_api_key)" || return 1
    local ids
    ids="$(curl -s -H "X-API-Key: $api_key" "$SYNCTHING_API/rest/config/folders" \
        | python3 -c "import sys,json;[print(f['id']) for f in json.load(sys.stdin)]")"
    [[ -n "$ids" ]] || { printf 'No folders registered locally.\n'; return 0; }
    printf '%-40s %s\n' "FOLDER" "STATE"
    while IFS= read -r id; do
        [[ -n "$id" ]] || continue
        local state
        state="$(curl -s -H "X-API-Key: $api_key" "$SYNCTHING_API/rest/db/status?folder=$id" \
            | python3 -c "import sys,json;d=json.load(sys.stdin);print(d.get('state','?'),'need='+str(d.get('needTotalItems',0)))" 2>/dev/null)"
        printf '%-40s %s\n' "$id" "$state"
    done <<< "$ids"
}

cmd_hub_doctor() {
    _require_hub_key || return 1
    local want; want="$(_hub_laptop_devices)"
    _hub_curl GET /rest/config/folders | python3 -c "
import sys,json
want=set(json.loads('''$want'''))
fs=json.load(sys.stdin)
print('hub folders:',len(fs))
for f in fs:
    devs=set(d['deviceID'] for d in f['devices'])
    miss=want-devs
    ver=f.get('versioning',{}).get('type') or 'NONE'
    flags=[]
    if miss: flags.append('missing-devices='+str(len(miss)))
    if ver=='NONE': flags.append('no-versioning')
    print(' ',f.get('label',f['id']),'OK' if not flags else 'WARN '+' '.join(flags))
"
}

cmd_add_all() {
    local count=0 fail=0
    while IFS= read -r git_dir; do
        local repo_path="${git_dir%/.git}"
        printf '[%s] ' "$(_rel_from_path "$repo_path")"
        if cmd_add "$repo_path"; then
            (( count++ ))
        else
            (( fail++ ))
        fi
    done < <(find "$GHQ_ROOT" -name ".git" -type d 2>/dev/null | sort)
    printf '\nDone: %d registered, %d failed.\n' "$count" "$fail"
}

_usage() {
    cat <<'EOF'
repo-sync — Register/unregister repos as Syncthing shared folders

Usage:
  repo-sync add <repo-path>   Register a repo with the hub server
  repo-sync add-all           Register all repos under GHQ_ROOT
  repo-sync get <git-url>     Clone via ghq then register with Syncthing + hub
  repo-sync adopt             Pull all hub-known repos onto this laptop
  repo-sync list              List all synced folders (id + path)
  repo-sync rm  <repo-path>   Remove a folder from Syncthing
  repo-sync status            Show sync state for every local folder
  repo-sync hub-doctor        Audit hub folders (devices, versioning)
  repo-sync --help            Show this help

Environment variables (all optional except STSYNC_SERVER_DEVICE_ID):
  STSYNC_APIKEY              API key — overrides ~/.local/state/syncthing/config.xml
  STSYNC_SERVER_DEVICE_ID    Device ID of the hub server  (required; never hardcoded)
  STSYNC_URL                 Syncthing API base URL  [default: http://127.0.0.1:8384]
  GHQ_ROOT                   Root of the ghq tree    [default: ~/repos]
  STIGNORE_TEMPLATE          Path to .stignore template
  STSYNC_SERVER_URL          Hub Syncthing URL  [default: https://sync.ayplace.xyz]
  STSYNC_SERVER_REPOS_ROOT   Hub container repo root  [default: /var/syncthing/data]
  STSYNC_SERVER_APIKEY       Hub API key (store in ~/.shell/.env.local, never commit)

The API key is read from STSYNC_APIKEY, or parsed from
~/.local/state/syncthing/config.xml (created automatically when Syncthing
runs for the first time).

STSYNC_SERVER_DEVICE_ID must be set to the hub server's device ID.
Find it in the Syncthing web UI: Actions > Show ID.
EOF
}

# ---------------------------------------------------------------------------
# Dispatch (only when executed, not when sourced for tests)
# ---------------------------------------------------------------------------
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
    case "${1:-}" in
        add)             shift; cmd_add    "$@" ;;
        add-all)                cmd_add_all     ;;
        get)             shift; cmd_get    "$@" ;;
        adopt)           shift; cmd_adopt  "$@" ;;
        list)                   cmd_list        ;;
        rm)              shift; cmd_rm     "$@" ;;
        status)                 cmd_status      ;;
        hub-doctor)             cmd_hub_doctor  ;;
        --help|-h|help)         _usage          ;;
        "")                     _usage; exit 1  ;;
        *) printf 'Unknown subcommand: %s\n\n' "$1" >&2; _usage >&2; exit 1 ;;
    esac
fi
